<?xml version="1.0" encoding="utf-8"?>
<!-- Launchers before Android 8 have no adaptive icons, so the layers are drawn as a circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#2AABEE" />
        </shape>
    </item>
    <item android:drawable="@drawable/phogram_icon_foreground" />
</layer-list>
